<?xml version="1.0" encoding="utf-8" ?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Duty tracking. Without these declared, Capacitor's WebView geolocation
      handler still asks Android for the permission, but Android denies an
      undeclared permission INSTANTLY and without a dialog — so Start Duty failed
      with PERMISSION_DENIED, no box ever appeared, and the page could only report
      "site: prompt · error 1". Nothing in the web app or in Chrome's settings
      could have fixed that; the permission has to exist here.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Declared AHEAD of the web app needing them, on purpose.

      Everything the engineers see comes from the live site, so a web change
      reaches them with no new APK. Permissions are the one thing that cannot
      arrive that way — they live in this file, inside the APK. So every
      permission the app is plausibly going to want is declared now, once, and a
      future feature needs no reinstall on 24 phones.

      Declaring a permission grants nothing. Android still asks the engineer the
      first time a feature actually uses it, and the app asks for nothing it is
      not using. An undeclared one, by contrast, is denied instantly and without
      a dialog — which is exactly how Start Duty broke.
    -->

    <!-- Photographing a completed job / attaching a proof-of-work picture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Picking an existing picture: split by API level, as Android 13 replaced
         the single storage permission with per-type media ones. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Telling an engineer about a new case, or that duty is still running.
         Required from Android 13; a no-op below it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Local reminders survive a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      For duty tracking that keeps working with the screen off. The service and
      its notification are still to be built — this only means that when they
      are, the APK does not have to go out again.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Hardware the app uses when it is there, but must never be a reason an
      install is refused.

      tools:replace is load-bearing: the background-geolocation plugin declares
      this feature WITHOUT required="false", and a merged required="true" would
      make Android refuse to install the app on any device it thinks has no GPS.
      Our own declaration has to win.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
